rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/superAdmins/$(request.auth.uid)).data.isActive == true;
    }

    function isAdmin(organizationId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/admins/$(request.auth.uid)).data.isActive == true;
    }

    function isOrgStaff(organizationId) {
      return isAdmin(organizationId) || isSuperAdmin();
    }

    function isApprovedMember(organizationId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.status == "approved";
    }

    function isPublicAnnouncement(data) {
      return (
          data.keys().hasAny(["publishScope"])
          && data.publishScope == "public"
        )
        || (
          data.keys().hasAny(["messageType"])
          && data.messageType == "publicAnnouncement"
        )
        || (
          data.keys().hasAny(["visibility"])
          && data.visibility == "public"
        )
        || (
          data.keys().hasAny(["deliveryType"])
          && data.deliveryType == "公開お知らせ"
        );
    }

    function canReviewMembers(organizationId) {
      let adminPath = /databases/$(database)/documents/organizations/$(organizationId)/admins/$(request.auth.uid);
      let admin = isSignedIn() && exists(adminPath) ? get(adminPath).data : {};
      return isSuperAdmin()
        || (
          isAdmin(organizationId)
          && (
            (
              admin.keys().hasAny(["role"])
              && admin.role == "owner"
            )
            || !admin.keys().hasAny(["permissions"])
            || (
              admin.permissions is list
              && (
                "memberReview" in admin.permissions
                || "メンバー閲覧・承認" in admin.permissions
              )
            )
            || (
              admin.permissions is map
              && (
                (
                  admin.permissions.keys().hasAny(["memberReview"])
                  && admin.permissions["memberReview"] == true
                )
                || (
                  admin.permissions.keys().hasAny(["メンバー閲覧・承認"])
                  && admin.permissions["メンバー閲覧・承認"] == true
                )
              )
            )
          )
        );
    }

    function isOrgActive(organizationId) {
      return exists(/databases/$(database)/documents/organizations/$(organizationId))
        && get(/databases/$(database)/documents/organizations/$(organizationId)).data.isActive == true;
    }

    function isMembershipApplication(data, organizationId, memberUid) {
      return data.keys().hasOnly([
          "uid",
          "userId",
          "organizationId",
          "communityId",
          "role",
          "status",
          "applicantName",
          "applicantFurigana",
          "applicantEmail",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasAll([
          "uid",
          "userId",
          "organizationId",
          "communityId",
          "role",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && data.uid == memberUid
        && data.userId == memberUid
        && data.organizationId == organizationId
        && data.communityId == organizationId
        && data.role == "member"
        && data.status == "pending"
        && (
          !data.keys().hasAny(["applicantName"])
          || data.applicantName is string
        )
        && (
          !data.keys().hasAny(["applicantFurigana"])
          || data.applicantFurigana is string
        )
        && (
          !data.keys().hasAny(["applicantEmail"])
          || (
            data.applicantEmail is string
            && data.applicantEmail == request.auth.token.email
          )
        );
    }

    function isSharedManualData(data) {
      return data.keys().hasOnly([
          "communityId",
          "title",
          "body",
          "sortOrder",
          "isPublished",
          "imageUrls",
          "pdfUrl",
          "externalUrl",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasAll([
          "title",
          "body",
          "sortOrder",
          "isPublished",
          "imageUrls"
        ])
        && data.title is string
        && data.body is string
        && data.sortOrder is int
        && data.isPublished is bool
        && data.imageUrls is list
        && (
          !data.keys().hasAny(["communityId"])
          || data.communityId == null
          || data.communityId is string
        )
        && (
          !data.keys().hasAny(["pdfUrl"])
          || data.pdfUrl == null
          || data.pdfUrl is string
        )
        && (
          !data.keys().hasAny(["externalUrl"])
          || data.externalUrl == null
          || data.externalUrl is string
        );
    }

    match /superAdmins/{uid} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /sharedManuals/{manualId} {
      allow read: if resource.data.isPublished == true || isSuperAdmin();
      allow create, update: if isSuperAdmin()
        && isSharedManualData(request.resource.data)
        && (
          !request.resource.data.keys().hasAny(["communityId"])
          || request.resource.data.communityId == null
        );
      allow delete: if isSuperAdmin();
    }

    match /memberPrivate/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "name",
          "furigana",
          "phone",
          "lastAppliedOrganizationId",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "uid",
          "email",
          "name",
          "furigana",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.furigana is string
        && (
          !request.resource.data.keys().hasAny(["phone"])
          || request.resource.data.phone is string
        )
        && (
          !request.resource.data.keys().hasAny(["lastAppliedOrganizationId"])
          || request.resource.data.lastAppliedOrganizationId is string
        );

      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "name",
          "furigana",
          "phone",
          "lastAppliedOrganizationId",
          "updatedAt"
        ]);

      allow delete: if isOwner(uid);

      match /budgetSettlementReports/{reportId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /entries/{entryId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      match /fcmTokens/{tokenId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            "id",
            "userId",
            "token",
            "appVariant",
            "os",
            "environment",
            "updatedAt"
          ])
          && request.resource.data.keys().hasAll([
            "id",
            "userId",
            "token",
            "appVariant",
            "os",
            "environment",
            "updatedAt"
          ])
          && request.resource.data.id == tokenId
          && request.resource.data.userId == uid
          && request.resource.data.token is string
          && request.resource.data.appVariant == "next"
          && request.resource.data.os in ["iOS", "Android"]
          && request.resource.data.environment in ["development", "production"]
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isOwner(uid);
      }

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    match /organizations/{organizationId} {

      allow read: if isSignedIn()
        || resource.data.communitySurfingVisible == true;
      allow create, update: if isSuperAdmin();
      allow delete: if false;

      match /admins/{adminUid} {
        allow read: if isOrgStaff(organizationId);
        allow create, update, delete: if isSuperAdmin();
      }

      match /members/{memberUid} {
        allow read: if canReviewMembers(organizationId) || isOwner(memberUid);

        allow create: if isOwner(memberUid)
          && isMembershipApplication(
            request.resource.data,
            organizationId,
            memberUid
          );

        allow update: if (
            canReviewMembers(organizationId)
            && resource.data.status == "pending"
            && request.resource.data.status in ["approved", "rejected"]
            && request.resource.data.reviewedByUserId == request.auth.uid
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "status",
              "reviewedByUserId",
              "reviewedAt",
              "updatedAt"
            ])
          )
          || (
            isOwner(memberUid)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.organizationId == resource.data.organizationId
            && request.resource.data.communityId == resource.data.communityId
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "updatedAt"
            ])
          );

        allow delete: if canReviewMembers(organizationId);
      }

      match /auditLogs/{auditId} {
        allow read: if canReviewMembers(organizationId);
        allow create: if canReviewMembers(organizationId)
          && request.resource.data.keys().hasOnly([
            "action",
            "actorUserId",
            "targetUserId",
            "communityId",
            "createdAt"
          ])
          && request.resource.data.keys().hasAll([
            "action",
            "actorUserId",
            "targetUserId",
            "communityId",
            "createdAt"
          ])
          && request.resource.data.action in [
            "membership.approved",
            "membership.rejected"
          ]
          && request.resource.data.actorUserId == request.auth.uid
          && request.resource.data.targetUserId is string
          && request.resource.data.communityId == organizationId;
        allow update, delete: if false;
      }

      match /memberRegistrations/{memberUid} {
        allow read: if isOrgStaff(organizationId) || isOwner(memberUid);

        allow create, update: if isOwner(memberUid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.organizationId == organizationId
          && request.resource.data.status == "pending";

        allow delete: if isOrgStaff(organizationId);
      }

      match /memberRequests/{requestId} {
        allow read: if isOrgStaff(organizationId);

        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == "pending";

        allow update, delete: if isOrgStaff(organizationId);
      }

      match /memberPosts/{postId} {
        allow read: if isOrgStaff(organizationId)
          || (isSignedIn() && resource.data.memberUid == request.auth.uid);

        allow create: if isSignedIn()
          && isApprovedMember(organizationId)
          && request.resource.data.memberUid == request.auth.uid;

        allow update, delete: if isOrgStaff(organizationId)
          || (
            isApprovedMember(organizationId)
            && resource.data.memberUid == request.auth.uid
            && request.resource.data.memberUid == request.auth.uid
          );

        match /replies/{replyId} {
          allow read: if isOrgStaff(organizationId)
            || (
              isSignedIn()
              && exists(/databases/$(database)/documents/organizations/$(organizationId)/memberPosts/$(postId))
              && get(/databases/$(database)/documents/organizations/$(organizationId)/memberPosts/$(postId)).data.memberUid == request.auth.uid
            );

          allow create, update, delete: if isOrgStaff(organizationId);
        }
      }

      match /messages/{messageId} {
        allow read: if isOrgActive(organizationId)
          && (
            isPublicAnnouncement(resource.data)
            || isApprovedMember(organizationId)
            || isOrgStaff(organizationId)
          );
        allow create, delete: if isOrgStaff(organizationId);

        allow update: if isOrgStaff(organizationId)
          || (
            isSignedIn()
            && isOrgActive(organizationId)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "isReadBy",
              "updatedAt"
            ])
          );
      }

      match /announcements/{announcementId} {
        allow read: if isOrgActive(organizationId)
          && (
            isPublicAnnouncement(resource.data)
            || isApprovedMember(organizationId)
            || isOrgStaff(organizationId)
          );
        allow create, update, delete: if isOrgStaff(organizationId);
      }

      match /categories/{categoryId} {
        allow read: if isSignedIn() && isOrgActive(organizationId);
        allow create, update, delete: if isOrgStaff(organizationId);
      }

      match /videos/{videoId} {
        allow read: if isSignedIn() && isOrgActive(organizationId);
        allow create, update, delete: if isOrgStaff(organizationId);
      }

      match /manuals/{manualId} {
        allow read: if resource.data.isPublished == true
          && (isApprovedMember(organizationId) || isOrgStaff(organizationId));
        allow create, update: if isOrgStaff(organizationId)
          && isSharedManualData(request.resource.data)
          && request.resource.data.keys().hasAny(["communityId"])
          && request.resource.data.communityId == organizationId;
        allow delete: if isOrgStaff(organizationId);
      }

      match /bookingEvents/{eventId} {
        allow read: if isSignedIn() && isOrgActive(organizationId);
        allow create, update, delete: if isOrgStaff(organizationId);

        match /slots/{slotId} {
          allow read: if isSignedIn() && isOrgActive(organizationId);
          allow create, update, delete: if isOrgStaff(organizationId);
        }

        match /reservations/{reservationId} {
          allow read: if isOrgStaff(organizationId)
            || (isSignedIn() && resource.data.uid == request.auth.uid);

          allow create: if isSignedIn()
            && request.resource.data.uid == request.auth.uid;

          allow update, delete: if isOrgStaff(organizationId)
            || (isSignedIn() && resource.data.uid == request.auth.uid);
        }
      }

      match /settings/{document} {
        allow read: if isSignedIn() && isOrgActive(organizationId);
        allow write: if isOrgStaff(organizationId);
      }

      match /private/{document=**} {
        allow read, write: if isOrgStaff(organizationId);
      }

      match /{document=**} {
        allow read, write: if isSuperAdmin();
      }
    }

    match /{path=**}/publicPosts/{postId} {
      allow read: if resource.data.isPublic == true;
      allow create, update, delete: if false;
    }

    // 所属一覧のcollection-group取得用。利用者本人のデータだけを返す。
    match /{path=**}/members/{memberUid} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // 管理者本人の権限確認用。
    match /{path=**}/admins/{adminUid} {
      allow read: if isOwner(adminUid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
